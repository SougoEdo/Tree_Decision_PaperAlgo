\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Edge 0.10, rows: trading rate, columns: setting. Share of the ideal rule's test gain captured; annualized test Sharpe ratio (ideal rule in brackets); mean number of leaves; turnover per decision (ideal rule in brackets).}}{20}{figure.caption.20}\protected@file@percent }
\newlabel{fig:enh-maps}{{14}{20}{Edge 0.10, rows: trading rate, columns: setting. Share of the ideal rule's test gain captured; annualized test Sharpe ratio (ideal rule in brackets); mean number of leaves; turnover per decision (ideal rule in brackets)}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces The split-search options at edge 0.10, 40 datasets per row ($h$: days between decisions; turnover is in Figure~\ref {fig:enh-maps}). At edge 0.05 no setting improves on the base (gain captured 36--48\% for the base, 30--49\% with deciles, with or without refinement, 24--49\% with all three), and smoothing alone loses most of it (8--23\%).}}{20}{table.caption.21}\protected@file@percent }
\newlabel{tab:enhancements}{{7}{20}{The split-search options at edge 0.10, 40 datasets per row ($h$: days between decisions; turnover is in Figure~\ref {fig:enh-maps}). At edge 0.05 no setting improves on the base (gain captured 36--48\% for the base, 30--49\% with deciles, with or without refinement, 24--49\% with all three), and smoothing alone loses most of it (8--23\%)}{table.caption.21}{}}
