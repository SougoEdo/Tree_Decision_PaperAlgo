\newlabel{fig:world}{{1}{2}{A stretch of one dataset. The background colour is the true regime, which the tree never sees. A decision is taken at each grey tick and held until the next one, while the regime keeps changing}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}What should a correct tree find? Not $d$}{3}{section.3}\protected@file@percent }
\newlabel{sec:target}{{3}{3}{What should a correct tree find? Not $d$}{section.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One dataset. \emph  {Top:} every dot is one training decision; the blue curve is the true expected 10-step return given $x$; the orange steps are the two leaves of the fitted tree. \emph  {Bottom:} the position that the optimizer takes with the true curve (blue) and with the tree's leaves (orange). Vertical lines: planted $d$ (dashed), sign change of the true curve (dotted), the tree's threshold (orange). The upper leaf sits at $+10\%$, the largest value the search allows: leaf values are inputs to the optimizer, not forecasts, and any value above 3.6\% gives the same fully invested portfolio.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:learned}{{2}{4}{One dataset. \emph {Top:} every dot is one training decision; the blue curve is the true expected 10-step return given $x$; the orange steps are the two leaves of the fitted tree. \emph {Bottom:} the position that the optimizer takes with the true curve (blue) and with the tree's leaves (orange). Vertical lines: planted $d$ (dashed), sign change of the true curve (dotted), the tree's threshold (orange). The upper leaf sits at $+10\%$, the largest value the search allows: leaf values are inputs to the optimizer, not forecasts, and any value above 3.6\% gives the same fully invested portfolio}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{4}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}One dataset}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces One dataset; all figures are per decision (10 steps). The returns are huge because the planted drift is huge; only the comparison between the lines matters.}}{4}{table.caption.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The first 60 test decisions of the same dataset. The tree (orange) goes to cash when $x$ is below its threshold and is fully invested otherwise; the ideal rule (dashed blue) differs only by taking partial positions in the narrow band where the expected return is small.}}{5}{figure.caption.5}\protected@file@percent }
\newlabel{fig:decisions}{{3}{5}{The first 60 test decisions of the same dataset. The tree (orange) goes to cash when $x$ is below its threshold and is fully invested otherwise; the ideal rule (dashed blue) differs only by taking partial positions in the narrow band where the expected return is small}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Where the threshold lands, over 100 datasets}{5}{subsection.4.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces All thresholds on $x$ kept in the final trees, over 100 independent datasets per panel. \emph  {Left:} one decision per step; the right target is $d$. \emph  {Right:} one decision every 10 steps; the right target is the zone between the sign change (dotted) and about $-0.3$.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:hist}{{4}{6}{All thresholds on $x$ kept in the final trees, over 100 independent datasets per panel. \emph {Left:} one decision per step; the right target is $d$. \emph {Right:} one decision every 10 steps; the right target is the zone between the sign change (dotted) and about $-0.3$}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Effect of the speed of the feature and of the volatility of the price}{6}{subsection.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Twenty datasets per cell. Rows: reversion speed $k$ of the feature (top: slow, a regime lasts many decisions; bottom: fast, the regime at the decision says little about the next 10 steps). Columns: volatility of the price per step, with the ratio drift/volatility in brackets.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:maps}{{5}{7}{Twenty datasets per cell. Rows: reversion speed $k$ of the feature (top: slow, a regime lasts many decisions; bottom: fast, the regime at the decision says little about the next 10 steps). Columns: volatility of the price per step, with the ratio drift/volatility in brackets}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces First threshold found on $x$, for each speed $k$, at the base volatility. Diamonds: where the true expected 10-step return changes sign.}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:byk}{{6}{7}{First threshold found on $x$, for each speed $k$, at the base volatility. Diamonds: where the true expected 10-step return changes sign}{figure.caption.8}{}}
