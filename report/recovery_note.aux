\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Weekly decisions: the weight of the asset taken on the test decisions, by $x$ on the decision day. Orange: the tree (median over the 40 datasets, and the quartiles as a band); dashed blue: the ideal rule, the optimizer fed with the true $g_5(x)$. One row per setting; \emph  {left:} edge 0.05, \emph  {right:} edge 0.10. Panel titles: mean number of leaves, annualized test Sharpe ratio of the tree (ideal rule in brackets).}}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:positions}{{10}{14}{Weekly decisions: the weight of the asset taken on the test decisions, by $x$ on the decision day. Orange: the tree (median over the 40 datasets, and the quartiles as a band); dashed blue: the ideal rule, the optimizer fed with the true $g_5(x)$. One row per setting; \emph {left:} edge 0.05, \emph {right:} edge 0.10. Panel titles: mean number of leaves, annualized test Sharpe ratio of the tree (ideal rule in brackets)}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Edge 0.10, rows: trading rate, columns: setting. Share of the ideal rule's test gain captured; annualized test Sharpe ratio (ideal rule in brackets); mean number of leaves kept; turnover per decision (ideal rule in brackets).}}{15}{figure.caption.16}\protected@file@percent }
\newlabel{fig:settings-maps}{{11}{15}{Edge 0.10, rows: trading rate, columns: setting. Share of the ideal rule's test gain captured; annualized test Sharpe ratio (ideal rule in brackets); mean number of leaves kept; turnover per decision (ideal rule in brackets)}{figure.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The settings experiment at edge 0.10, 40 datasets per row ($h$: days between decisions). ``Leaves'': mean number of leaves kept; ``median'': first threshold on $x$ over the datasets that split. At edge 0.05 no setting beats the base: the tree's Sharpe ratio is 0.19--0.27 for the base and 0.12--0.19 with $\lambda =5$ or 10, and with a 10 bp fee the tree hardly trades at the fast rates (0.08--0.09).}}{16}{table.caption.17}\protected@file@percent }
\newlabel{tab:settings}{{6}{16}{The settings experiment at edge 0.10, 40 datasets per row ($h$: days between decisions). ``Leaves'': mean number of leaves kept; ``median'': first threshold on $x$ over the datasets that split. At edge 0.05 no setting beats the base: the tree's Sharpe ratio is 0.19--0.27 for the base and 0.12--0.19 with $\lambda =5$ or 10, and with a 10 bp fee the tree hardly trades at the fast rates (0.08--0.09)}{table.caption.17}{}}
