\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}One dataset}{4}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Base parameters, weekly decisions, dataset 42. \emph  {Top:} realised 5-day returns by bin of $x$ (training decisions), the true $g_5(x)$ of \eqref  {eq:g}, and the tree's leaf scores. \emph  {Bottom:} the position the optimizer takes with the true curve and with the tree. Growth made three splits. Pruning removed the one at $x\le -2.01$ and kept the root split at $x\le 0.12$ (on the checking decisions: regret $0.0097\to 0.0066$ per decision, Sharpe $0.06\to 0.20$) together with a second-level one at $x\le 1.60$ (31 decisions, regret $0.0067\to 0.0066$), an example of the tail leaves discussed in Section~\ref {sec:says}.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:learned}{{2}{4}{Base parameters, weekly decisions, dataset 42. \emph {Top:} realised 5-day returns by bin of $x$ (training decisions), the true $g_5(x)$ of \eqref {eq:g}, and the tree's leaf scores. \emph {Bottom:} the position the optimizer takes with the true curve and with the tree. Growth made three splits. Pruning removed the one at $x\le -2.01$ and kept the root split at $x\le 0.12$ (on the checking decisions: regret $0.0097\to 0.0066$ per decision, Sharpe $0.06\to 0.20$) together with a second-level one at $x\le 1.60$ (31 decisions, regret $0.0067\to 0.0066$), an example of the tail leaves discussed in Section~\ref {sec:says}}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The same dataset out of sample. \emph  {Top, middle:} the first 60 test decisions; the tree is in cash below its threshold and fully invested above, like the ideal rule. \emph  {Bottom:} wealth over the 5 test years. This test window is dominated by the down regime (the asset loses 22\% a year), so every rule earns little; what the figure shows is the decisions, not the level of the returns.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:decisions}{{3}{5}{The same dataset out of sample. \emph {Top, middle:} the first 60 test decisions; the tree is in cash below its threshold and fully invested above, like the ideal rule. \emph {Bottom:} wealth over the 5 test years. This test window is dominated by the down regime (the asset loses 22\% a year), so every rule earns little; what the figure shows is the decisions, not the level of the returns}{figure.caption.4}{}}
