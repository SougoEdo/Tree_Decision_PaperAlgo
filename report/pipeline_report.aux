\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Current rule, 20 datasets per row. Columns 3 to 5: mean of the paired differences of annualised test Sharpe ratios, standard error in brackets. Last column: median annualised Sharpe ratio of the tree on the training weeks and on the test year.}}{14}{table.caption.10}\protected@file@percent }
\newlabel{tab:lambda}{{6}{14}{Current rule, 20 datasets per row. Columns 3 to 5: mean of the paired differences of annualised test Sharpe ratios, standard error in brackets. Last column: median annualised Sharpe ratio of the tree on the training weeks and on the test year}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces When do leaves help? Current rule, $\lambda =10$, single-feature generator, 20 datasets per row; ``flat'' is the tree without splits; ``half the noise'' is 1.5\% daily volatility. Columns 2 to 5 compare \emph  {medians over the 20 datasets}, flat $\to $ tree: relative change of the median (over datasets) of the mean weekly regret, and the two median annualised Sharpe ratios. The last column is the \emph  {mean of the paired differences} with its standard error; it need not have the sign of the difference of medians. In training, leaves always help, even with no signal. On the test year they make the regret worse, except in the last row, where the first split is on a momentum feature in 20 of 20 datasets. Note the $+0.11$ (0.06) obtained with no signal at all: it is the yardstick for reading the other rows.}}{15}{table.caption.11}\protected@file@percent }
\newlabel{tab:leaves}{{7}{15}{When do leaves help? Current rule, $\lambda =10$, single-feature generator, 20 datasets per row; ``flat'' is the tree without splits; ``half the noise'' is 1.5\% daily volatility. Columns 2 to 5 compare \emph {medians over the 20 datasets}, flat $\to $ tree: relative change of the median (over datasets) of the mean weekly regret, and the two median annualised Sharpe ratios. The last column is the \emph {mean of the paired differences} with its standard error; it need not have the sign of the difference of medians. In training, leaves always help, even with no signal. On the test year they make the regret worse, except in the last row, where the first split is on a momentum feature in 20 of 20 datasets. Note the $+0.11$ (0.06) obtained with no signal at all: it is the yardstick for reading the other rows}{table.caption.11}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Regret reduction by luck and by signal, from a probe of the root that fully fits the 12 best-screened splits plus the best-screened split of every other feature. Realistic signals do not stand out from luck with five years of data. Take as threshold the 90th percentile of luck (2 of the 16 no-signal datasets exceed it by construction) and require the Sharpe ratio to rise. At $\lambda =1$ a split is then accepted in 2 of 16 single-feature datasets, 2 of 16 interaction datasets and 9 of 16 datasets with the exact regime feature; 12 of these 13 splits are on an informative feature. So about 85\% of the realistic signals are missed, and half of the exact ones.}}{15}{table.caption.12}\protected@file@percent }
\newlabel{tab:gate}{{8}{15}{Regret reduction by luck and by signal, from a probe of the root that fully fits the 12 best-screened splits plus the best-screened split of every other feature. Realistic signals do not stand out from luck with five years of data. Take as threshold the 90th percentile of luck (2 of the 16 no-signal datasets exceed it by construction) and require the Sharpe ratio to rise. At $\lambda =1$ a split is then accepted in 2 of 16 single-feature datasets, 2 of 16 interaction datasets and 9 of 16 datasets with the exact regime feature; 12 of these 13 splits are on an informative feature. So about 85\% of the realistic signals are missed, and half of the exact ones}{table.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Size of each term of the utility~\eqref  {eq:utility}: current rule, single-feature data, means over 5 datasets. At $\lambda =1$ the covariance penalty is a tenth of the returns; at $\lambda =50$ it is four times larger.}}{15}{table.caption.13}\protected@file@percent }
\newlabel{tab:scale}{{9}{15}{Size of each term of the utility~\eqref {eq:utility}: current rule, single-feature data, means over 5 datasets. At $\lambda =1$ the covariance penalty is a tenth of the returns; at $\lambda =50$ it is four times larger}{table.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces What pruning on checking weeks changes. State (iii): ten years (332 fitting, 111 checking and 52 test weeks), fee of 3 basis points, $\lambda =10$, depth 2, \texttt  {max_thresholds=100}, single-feature generator, 20 datasets per column; ``half the noise'' is 1.5\% daily volatility. ``No pruning'' is the tree grown on all 443 training weeks, as before. With no signal every feature is a noise feature. A split that passes can still disappear later with a split above it. For scale, the weekly test regret of the tree without splits is about $300\times 10^{-4}$ ($190\times 10^{-4}$ at half the noise).}}{16}{table.caption.14}\protected@file@percent }
\newlabel{tab:prune}{{10}{16}{What pruning on checking weeks changes. State (iii): ten years (332 fitting, 111 checking and 52 test weeks), fee of 3 basis points, $\lambda =10$, depth 2, \code {max_thresholds=100}, single-feature generator, 20 datasets per column; ``half the noise'' is 1.5\% daily volatility. ``No pruning'' is the tree grown on all 443 training weeks, as before. With no signal every feature is a noise feature. A split that passes can still disappear later with a split above it. For scale, the weekly test regret of the tree without splits is about $300\times 10^{-4}$ ($190\times 10^{-4}$ at half the noise)}{table.caption.14}{}}
